{
  "name": "dsh-dev-context",
  "version": "0.2.0",
  "private": false,
  "description": "把本机安装的 DeepSeek Harness 投影成一份带版本戳的小索引；DSH 版本变化时自动重建，供任何 AI harness 读取。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "scripts/*.mjs",
    "skills/dsh-dev-context/SKILL.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check lib/context.mjs && node --check scripts/check.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "context",
    "index",
    "development"
  ],
  "license": "MIT",
  "author": {
    "name": "leo",
    "url": "https://github.com/tula-liuxin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tula-liuxin/dsh-dev-context.git"
  },
  "homepage": "https://github.com/tula-liuxin/dsh-dev-context#readme",
  "bugs": {
    "url": "https://github.com/tula-liuxin/dsh-dev-context/issues"
  }
}
